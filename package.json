{
  "name": "fast-v1-mesh-sculptor",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:renderer": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop:dev": "node scripts/start-electron-dev.mjs",
    "desktop:build": "npm run build:renderer && npm run build:electron",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "cdt2d": "^1.0.0",
    "earcut": "^3.0.2",
    "three": "^0.183.2",
    "three-mesh-bvh": "^0.9.9"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/three": "^0.183.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "build": {
    "appId": "com.nourasoft.desktop",
    "productName": "NouraSoft",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
